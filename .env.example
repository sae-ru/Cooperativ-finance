# Non-secret node configuration. Secrets are stored only in ./secrets/ files.
COOP_HTTP_PORT=8080
COOP_ENVIRONMENT=dev
COOP_RELEASE=0.1.0-dev
COOP_NODE_CODE=node-demo-01
COOP_NODE_DISPLAY_NAME=Demonstration cooperative node
COOP_LOG_LEVEL=INFO
COOP_DEMO_DATA_ENABLED=true

# Local operations warnings; no external monitoring service is required.
COOP_HOST_PROBE_STALE_SECONDS=180
COOP_DISK_WARNING_PERCENT=15
COOP_DISK_CRITICAL_PERCENT=5
COOP_CLOCK_DRIFT_WARNING_SECONDS=5
COOP_CLOCK_DRIFT_CRITICAL_SECONDS=60
COOP_BACKUP_WARNING_HOURS=36
COOP_BACKUP_CRITICAL_HOURS=72
COOP_CERTIFICATE_WARNING_DAYS=30
COOP_CERTIFICATE_CRITICAL_DAYS=7

# Enables the explicit, idempotent demo-data job for local evaluation.
COMPOSE_PROFILES=demo
