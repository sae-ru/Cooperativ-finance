# Non-secret node configuration. Secrets are stored only in ./secrets/ files.
COOP_HTTP_PORT=8080
COOP_ENVIRONMENT=dev
COOP_RELEASE=0.1.0-dev
COOP_NODE_CODE=node-demo-01
COOP_NODE_DISPLAY_NAME=Demonstration cooperative node
COOP_LOG_LEVEL=INFO
COOP_DEMO_DATA_ENABLED=true

# Enables the explicit, idempotent demo-data job for local evaluation.
COMPOSE_PROFILES=demo
